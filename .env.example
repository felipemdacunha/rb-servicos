# Porta HTTP
PORT=3000

# Banco local (arquivo criado automaticamente). Usado quando TURSO_DATABASE_URL está vazio.
DATABASE_PATH=./data/rb-servicos.db

# Banco na nuvem (Turso). Preenchido: usa a nuvem e ignora DATABASE_PATH.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# "true" atrás de HTTPS (Render)
COOKIE_SECURE=false
TRUST_PROXY=false
